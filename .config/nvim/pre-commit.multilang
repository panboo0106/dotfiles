#!/bin/bash
# Pre-commit Hook - 多语言代码检查
# 支持: JavaScript, C++, Shell, Python, Go
# 基于 SFRD-PPQA-03-6.7 编码规范

set -e

echo "🔍 运行 Pre-commit 检查..."

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 获取暂存的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 检查是否有文件被暂存
if [ -z "$STAGED_FILES" ]; then
    echo "⚠️  没有暂存的文件"
    exit 0
fi

echo "暂存的文件:"
echo "$STAGED_FILES"
echo ""

# ============ JavaScript 检查 ============
check_javascript() {
    local js_files=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx)$' || true)

    if [ -n "$js_files" ]; then
        echo -e "${YELLOW}📝 检查 JavaScript 文件...${NC}"

        for file in $js_files; do
            if [ -f "$file" ]; then
                echo "  检查 $file"

                # ESLint 检查
                if command -v eslint >/dev/null 2>&1; then
                    if ! eslint "$file" 2>/dev/null; then
                        echo -e "${RED}❌ ESLint 检查失败: $file${NC}"
                        echo "请运行: make js-lint 或 npm run lint"
                        return 1
                    fi
                fi

                # Prettier 格式检查
                if command -v prettier >/dev/null 2>&1; then
                    if ! prettier --check "$file" >/dev/null 2>&1; then
                        echo -e "${YELLOW}⚠️  $file 需要格式化${NC}"
                        echo "请运行: make js-format 或 npm run format"
                        # 不阻止提交，只警告
                    fi
                fi
            fi
        done
    fi
}

# ============ C++ 检查 ============
check_cpp() {
    local cpp_files=$(echo "$STAGED_FILES" | grep -E '\.(cpp|cc|h|hpp)$' || true)

    if [ -n "$cpp_files" ]; then
        echo -e "${YELLOW}📝 检查 C++ 文件...${NC}"

        for file in $cpp_files; do
            if [ -f "$file" ]; then
                echo "  检查 $file"

                # clang-format 格式检查
                if command -v clang-format >/dev/null 2>&1; then
                    if ! clang-format --dry-run --Werror "$file" >/dev/null 2>&1; then
                        echo -e "${YELLOW}⚠️  $file 需要格式化${NC}"
                        echo "请运行: make cpp-format"
                        # 不阻止提交，只警告
                    fi
                fi

                # clang-tidy 检查（可选，因为可能较慢）
                if [ "$ENABLE_CLANG_TIDY" = "true" ]; then
                    if command -v clang-tidy >/dev/null 2>&1; then
                        if ! clang-tidy "$file" --config-file="$HOME/.config/nvim/.clang-tidy" >/dev/null 2>&1; then
                            echo -e "${RED}❌ clang-tidy 检查失败: $file${NC}"
                            echo "请运行: make cpp-lint"
                            return 1
                        fi
                    fi
                fi
            fi
        done
    fi
}

# ============ Shell 检查 ============
check_shell() {
    local sh_files=$(echo "$STAGED_FILES" | grep -E '\.(sh|bash)$' || true)

    if [ -n "$sh_files" ]; then
        echo -e "${YELLOW}📝 检查 Shell 脚本...${NC}"

        for file in $sh_files; do
            if [ -f "$file" ]; then
                echo "  检查 $file"

                # ShellCheck 检查
                if command -v shellcheck >/dev/null 2>&1; then
                    if ! shellcheck "$file" 2>/dev/null; then
                        echo -e "${RED}❌ ShellCheck 检查失败: $file${NC}"
                        echo "请运行: make sh-lint"
                        return 1
                    fi
                fi

                # shfmt 格式检查
                if command -v shfmt >/dev/null 2>&1; then
                    if ! shfmt -l "$file" >/dev/null 2>&1; then
                        echo -e "${YELLOW}⚠️  $file 需要格式化${NC}"
                        echo "请运行: make sh-format"
                        # 不阻止提交，只警告
                    fi
                fi
            fi
        done
    fi
}

# ============ Python 检查 ============
check_python() {
    local py_files=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)

    if [ -n "$py_files" ]; then
        echo -e "${YELLOW}📝 检查 Python 文件...${NC}"

        for file in $py_files; do
            if [ -f "$file" ]; then
                echo "  检查 $file"

                # Ruff 检查
                if command -v ruff >/dev/null 2>&1; then
                    if ! ruff check --config="$HOME/.config/ruff/ruff.toml" "$file" 2>/dev/null; then
                        echo -e "${RED}❌ Ruff 检查失败: $file${NC}"
                        echo "请运行: make py-lint"
                        return 1
                    fi
                fi

                # Ruff 格式检查
                if command -v ruff >/dev/null 2>&1; then
                    if ! ruff format --check --config="$HOME/.config/ruff/ruff.toml" "$file" >/dev/null 2>&1; then
                        echo -e "${YELLOW}⚠️  $file 需要格式化${NC}"
                        echo "请运行: make py-format"
                        # 不阻止提交，只警告
                    fi
                fi
            fi
        done
    fi
}

# ============ Go 检查 ============
check_go() {
    local go_files=$(echo "$STAGED_FILES" | grep -E '\.go$' || true)

    if [ -n "$go_files" ]; then
        echo -e "${YELLOW}📝 检查 Go 文件...${NC}"

        for file in $go_files; do
            if [ -f "$file" ]; then
                echo "  检查 $file"

                # gofmt 格式检查
                if command -v gofmt >/dev/null 2>&1; then
                    if ! gofmt -l "$file" >/dev/null 2>&1; then
                        echo -e "${YELLOW}⚠️  $file 需要格式化${NC}"
                        echo "请运行: make go-format"
                        # 不阻止提交，只警告
                    fi
                fi
            fi
        done
    fi
}

# ============ 编码检查 ============
check_encoding() {
    echo -e "${YELLOW}📝 检查文件编码...${NC}"

    for file in $STAGED_FILES; do
        if [ -f "$file" ]; then
            # 检查文件编码
            encoding=$(file --mime-encoding "$file" 2>/dev/null | awk '{print $2}')
            if [ "$encoding" != "utf-8" ] && [ "$encoding" != "us-ascii" ]; then
                echo -e "${RED}❌ 文件编码错误: $file (${encoding})${NC}"
                echo "请确保文件为 UTF-8 编码"
                return 1
            fi

            # 检查是否有BOM
            if [ "$encoding" = "utf-8" ]; then
                if file "$file" | grep -q "UTF-8 (with BOM)"; then
                    echo -e "${YELLOW}⚠️  $file 包含 BOM，建议移除${NC}"
                fi
            fi
        fi
    done

    echo -e "${GREEN}✅ 文件编码检查通过${NC}"
}

# ============ 主流程 ============
main() {
    # 检查文件编码
    check_encoding

    # 检查各种语言
    check_javascript
    check_cpp
    check_shell
    check_python
    check_go

    echo ""
    echo -e "${GREEN}✅ Pre-commit 检查通过！${NC}"
    echo ""
    echo "📌 提示: 某些格式问题只作了警告，不影响提交"
    echo "📌 建议在推送前运行 make all 进行完整检查"
}

# 运行主流程
main
