{
  "env": {
    "browser": true,
    "es6": true,
    "node": true,
    "jquery": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    // ============ 01. style - 风格规范 ============
    // 1.1 label - 标识符命名
    "id-length": ["error", { "min": 3, "exceptions": ["i", "j", "k", "x", "y", "_", "$"] }],
    "camelcase": ["error", { "properties": "never", "ignoreDestructuring": true }],
    "new-cap": ["error", { "newIsCap": true, "capIsNew": false, "properties": true }],
    "no-shadow": "error",

    // 1.2 indent - 缩进
    "indent": ["error", 4, { "SwitchCase": 1, "VariableDeclarator": "first" }],

    // 1.3 comment - 注释
    "require-jsdoc": ["warn", {
      "require": {
        "FunctionDeclaration": true,
        "MethodDefinition": true,
        "ClassDeclaration": true,
        "FunctionExpression": false
      }
    }],
    "no-warning-comments": "warn",

    // 1.4 line - 代码行数
    "max-lines-per-function": ["error", { "max": 100, "skipBlankLines": true, "skipComments": true }],

    // 1.5 bracket - 不省略大括号
    "curly": ["error", "all"],

    // ============ 02. exception - 错误处理 ============
    // 2.1 input - 外部输入检查（需人工审查）

    // 2.2 param - 参数检查（需人工审查）

    // 2.3 return - 返回值检查（需人工审查）
    "no-throw-literal": "error",
    "prefer-promise-reject-errors": "error",

    // ============ 03. practice - 编码经验准则 ============
    // 3.1 compare - 比较运算
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-eq-null": "error",

    // 3.2 var - 变量定义
    "no-multi-assign": "error",
    "no-sequences": "error",
    "no-var": "warn",  // 推荐使用const/let

    // 3.3 attribute - 属性修改（需人工审查）

    // 3.4 instance - 实例化（需人工审查）

    // 3.5 namespace - 命名空间（需人工审查）
    "no-undef": "error",
    "no-global-assign": "error",

    // 3.6 eval - eval的使用
    "no-eval": "error",
    "no-implied-eval": "error",
    "prefer-promise-reject-errors": "error",

    // ============ 04. extjs - ExtJS开发 ============
    // 4.1 global - 全局变量
    "no-implicit-globals": "error",
    "no-unused-vars": ["error", { "vars": "all", "args": "none", "ignoreRestSiblings": false }],
    "block-scoped-var": "error",

    // ============ 其他推荐规则 ============
    "semi": ["error", "always"],
    "quotes": ["error", "double", { "avoidEscape": true }],
    "prefer-const": "warn",
    "no-const-assign": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-duplicate-case": "error",
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-extra-semi": "error",
    "no-multiple-empty-lines": ["error", { "max": 2, "maxEOF": 1 }],
    "no-trailing-spaces": "error",
    "comma-dangle": ["error", "never"],
    "arrow-spacing": ["error", { "before": true, "after": true }],
    "space-before-blocks": ["error", "always"],
    "keyword-spacing": ["error", { "before": true, "after": true }],
    "space-infix-ops": "error",
    "eol-last": ["error", "always"],
    "no-mixed-spaces-and-tabs": "error",
    "no-tabs": "warn"
  },
  "globals": {
    // ExtJS 全局变量
    "Ext": "readonly",
    "jQuery": "readonly",
    "$": "readonly"
  }
}
