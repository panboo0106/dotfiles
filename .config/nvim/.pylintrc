[MASTER]
# 指定要加载的插件
# load-plugins=pylint.extensions.docparams

# 使用多进程加速检查（0表示自动检测CPU核心数）
jobs=0

# 不加载的插件
# disable-plugins=

# 允许加载任意C扩展
unsafe-load-any-extension=no

# Python代码的文件扩展名
extension-pkg-whitelist=

# 忽略的文件或目录（支持正则表达式）
ignore=CVS,.git,__pycache__,.venv,venv,env,migrations

# 忽略的文件模式
ignore-patterns=

# 持久化存储，加快后续检查速度
persistent=yes

[MESSAGES CONTROL]
# 禁用的检查项（根据项目需要调整）
disable=
    # 格式相关（建议用black或其他格式化工具处理）
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0103,  # invalid-name (对于简短的变量名如i, j, x, y等)
    
    # 过于严格的检查
    R0903,  # too-few-public-methods
    R0913,  # too-many-arguments
    R0914,  # too-many-locals
    R0912,  # too-many-branches
    R0915,  # too-many-statements
    
    # 与类型检查工具冲突
    E1101,  # no-member (mypy处理更好)
    
    # 其他常见禁用项
    W0212,  # protected-access (有时需要访问_protected成员)
    W0511,  # fixme (TODO注释是正常的)
    C0301,  # line-too-long (交给black处理)

# 启用的检查项（可选）
# enable=

[REPORTS]
# 设置输出格式
output-format=colorized

# 报告中包含的内容
reports=no

# 评分
score=yes

[BASIC]
# 命名规范
# 参数名：小写+下划线，1-30字符
argument-naming-style=snake_case
argument-rgx=[a-z_][a-z0-9_]{0,30}$

# 属性名：小写+下划线
attr-naming-style=snake_case

# 类名：PascalCase
class-naming-style=PascalCase
class-rgx=[A-Z_][a-zA-Z0-9]+$

# 常量名：大写+下划线
const-naming-style=UPPER_CASE
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# 函数名：小写+下划线
function-naming-style=snake_case
function-rgx=[a-z_][a-z0-9_]{2,50}$

# 方法名：小写+下划线
method-naming-style=snake_case
method-rgx=[a-z_][a-z0-9_]{2,50}$

# 模块名：小写+下划线
module-naming-style=snake_case
module-rgx=[a-z_][a-z0-9_]{2,50}$

# 变量名：小写+下划线
variable-naming-style=snake_case
variable-rgx=[a-z_][a-z0-9_]{0,30}$

# 好的变量名示例
good-names=i,j,k,ex,Run,_,id,x,y,z,logger,app,db

# 坏的变量名示例（将被警告）
bad-names=foo,bar,baz,toto,tutu,tata

# 包含名称提示
include-naming-hint=yes

[FORMAT]
# 最大行长度（虽然禁用了检查，但作为参考）
max-line-length=100

# 缩进字符串
indent-string='    '

# 每个缩进级别的空格数
indent-after-paren=4

# 期望的换行符
# expected-line-ending-format=LF

[DESIGN]
# 最大参数数量
max-args=8

# 最大属性数量
max-attributes=15

# 最大布尔表达式数量
max-bool-expr=5

# 最大分支数量
max-branches=15

# 最大局部变量数量
max-locals=20

# 最大父类数量
max-parents=7

# 最大公共方法数量
max-public-methods=25

# 最大返回语句数量
max-returns=6

# 最大语句数量
max-statements=60

# 最小公共方法数量
min-public-methods=1

[SIMILARITIES]
# 最小重复行数
min-similarity-lines=4

# 忽略注释
ignore-comments=yes

# 忽略文档字符串
ignore-docstrings=yes

# 忽略导入
ignore-imports=yes

# 忽略签名
ignore-signatures=yes

[IMPORTS]
# 允许通配符导入
allow-wildcard-with-all=no

# 分析导入回退
analyse-fallback-blocks=no

# 已知第三方模块
known-third-party=

# 已知标准库模块
known-standard-library=

[CLASSES]
# 定义元类的有效名称
valid-metaclass-classmethod-first-arg=cls

# 有效的类方法第一个参数名称
valid-classmethod-first-arg=cls

# 排除受保护成员访问检查的类
exclude-protected=_asdict,_fields,_replace,_source,_make

[EXCEPTIONS]
# 覆盖的异常名称
overgeneral-exceptions=builtins.Exception

[TYPECHECK]
# 忽略的类
ignored-classes=SQLObject,optparse.Values,thread._local,_thread._local

# 忽略的模块
ignored-modules=

# 生成的成员
generated-members=

# 上下文管理器
contextmanager-decorators=contextlib.contextmanager

[LOGGING]
# 日志模块
logging-modules=logging

# 日志格式样式
# logging-format-style=old
